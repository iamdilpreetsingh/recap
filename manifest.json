{
  "manifest_version": 3,
  "name": "Recap",
  "version": "0.0.1",
  "action": {
    "default_title": "Open Recap panel",
    "default_icon": {
      "16": "src/Assets/recapLogo.png",
      "32": "src/Assets/recapLogo.png",
      "48": "src/Assets/recapLogo.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["src/content/index.tsx"]
    }
  ],
  "permissions": ["sidePanel", "storage", "tabs"],
  "host_permissions": ["https://meet.google.com/*"],
  "web_accessible_resources": [
    {
      "resources": ["panel/*", "assets/*"],
      "matches": ["https://meet.google.com/*"]
    }
  ],
  "icons": {
    "16": "src/Assets/recapLogo.png",
    "32": "src/Assets/recapLogo.png",
    "48": "src/Assets/recapLogo.png",
    "128": "src/Assets/recapLogo.png"
  }
}
