{
  "manifest_version": 3,
  "name": "Recap: Transcribe Your Google Meet Calls",
  "description": "Transcribe and save your Google Meet conversations with Recap.",
  "version": "1.0.1",
  "action": {
    "default_title": "Open Recap panel",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "src/Assets/recapLogo16.png",
      "128": "src/Assets/recapLogo128.png"
    }
  },
  "icons": {
    "16": "src/Assets/recapLogo16.png",
    "32": "src/Assets/recapLogo32.png",
    "48": "src/Assets/recapLogo128.png",
    "128": "src/Assets/recapLogo128.png"
  },

  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["src/content/index.tsx"]
    }
  ],
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://securetoken.googleapis.com/*",
    "http://localhost:3000/*"
  ],
  "externally_connectable": {
    "matches": ["http://localhost:5174/*"]
  },
  "web_accessible_resources": [
    {
      "resources": ["panel/*", "assets/*"],
      "matches": ["https://meet.google.com/*"]
    }
  ]
}
